rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: users can manage their own profile, anyone can read public basic info
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Places: read by everyone, only authenticated admins or verified users can write
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Trips: users manage their own saved trips
    match /trips/{tripId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Reviews: anyone can read reviews, signed-in users can write their own
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
