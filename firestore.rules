rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: allow read and write for profile synchronization
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Places: read by everyone, allow writes
    match /places/{placeId} {
      allow read: if true;
      allow write: if true;
    }

    // Trips: users can read and save trips
    match /trips/{tripId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews: anyone can read reviews, allow creating and updating reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
